# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ptflow"

# NextAuth - Generate with: openssl rand -base64 64
NEXTAUTH_SECRET="your-512-bit-secret-here-generate-with-openssl-rand-base64-64"
NEXTAUTH_URL="http://localhost:3000"
SEED_USER_PASSWORD="replace-with-a-unique-16-plus-character-disposable-password"

# Controlled clinical-data boundary (generate unique values; never commit real keys)
PHI_ENCRYPTION_KEY="base64-encoded-exactly-32-byte-key"
PHI_ENCRYPTION_KEY_ID="local-dev-v1"
IDENTITY_HASH_KEY="at-least-32-random-characters"
FHIR_TRUSTED_SOURCE_SYSTEMS="urn:example:disposable-fhir-source"

# One-time practice provisioning (never leave ALLOW enabled)
ALLOW_PRACTICE_PROVISION="NO"
PROVISION_PRACTICE_NAME="Synthetic Test Practice"
PROVISION_ADMIN_EMAIL="admin@example.invalid"
PROVISION_ARTIFACT_RETENTION_DAYS="2555"

# Local-only demo autofill; keep real values in the ignored .env file.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
